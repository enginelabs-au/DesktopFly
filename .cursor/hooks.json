{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/policy.mjs",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/policy.mjs",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/policy.mjs",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/hooks/policy.mjs",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/hooks/policy.mjs",
        "timeout": 5,
        "failClosed": true
      }
    ]
  }
}
