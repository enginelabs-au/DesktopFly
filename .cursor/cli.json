{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**)",
      "Shell(git:status*)",
      "Shell(git:diff*)",
      "Shell(git:log*)",
      "Shell(git:show*)",
      "Shell(git:rev-parse*)",
      "Shell(node:--test*)",
      "Shell(node:.cursor/scripts/validate-agent-config.mjs*)",
      "Shell(node:.cursor/skills/launch-pipeline/scripts/preflight.mjs*)",
      "Shell(node:.cursor/skills/launch-pipeline/scripts/validate-launch.mjs*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*.p12)",
      "Write(**/*.pfx)",
      "Read(**/credentials.json)",
      "Read(**/secrets.json)",
      "Write(**/credentials.json)",
      "Write(**/secrets.json)",
      "Write(AGENTS.md)",
      "Write(.cursor/AGENTS.md)",
      "Write(.cursor/INSTRUCTIONS.md)",
      "Write(.cursor/instructions/ROLES.md)",
      "Write(.cursor/agents/**)",
      "Write(.cursor/rules/**)",
      "Write(.cursor/hooks/**)",
      "Write(.cursor/hooks.json)",
      "Write(.cursor/cli.json)",
      "Write(.cursor/sandbox.json)",
      "Write(.cursor/permissions.json)",
      "Write(.cursor/mcp.json)",
      "Write(.cursor/scripts/bootstrap.sh)",
      "Write(.cursor/scripts/validate-agent-config.mjs)",
      "Write(.github/workflows/agent-governance.yml)",
      "Write(.cursorignore)",
      "Shell(git:reset*--hard*)",
      "Shell(git:clean*-f*)",
      "Shell(git:checkout*--*)",
      "Shell(git:restore*)",
      "Shell(git:branch*-D*)",
      "Shell(git:push*--force*)",
      "Shell(git:filter-repo*)",
      "Shell(git:filter-branch*)",
      "Shell(vercel:*--prod*)",
      "Shell(npx:*vercel*--prod*)",
      "Shell(vercel:promote*)",
      "Shell(vercel:rollback*)",
      "Shell(supabase:db push*)",
      "Shell(supabase:migration repair*)",
      "Shell(npx:*supabase*db push*)",
      "Shell(terraform:apply*)",
      "Shell(terraform:destroy*)",
      "Shell(kubectl:apply*)",
      "Shell(kubectl:delete*)",
      "Mcp(*:*create*)",
      "Mcp(*:*update*)",
      "Mcp(*:*delete*)",
      "Mcp(*:*remove*)",
      "Mcp(*:*move*)",
      "Mcp(*:*rename*)",
      "Mcp(*:*edit*)",
      "Mcp(*:*write*)",
      "Mcp(*:*deploy*)",
      "Mcp(*:*release*)",
      "Mcp(*:*publish*)",
      "Mcp(*:*apply*)",
      "Mcp(*:*execute*)",
      "Mcp(*:*run_sql*)",
      "Mcp(*:*merge*)",
      "Mcp(*:*send*)",
      "Mcp(*:*reply*)",
      "Mcp(*:*buy*)",
      "Mcp(*:*click*)",
      "Mcp(*:*tap*)",
      "Mcp(*:*type*)",
      "Mcp(*:*fill*)",
      "Mcp(*:*select*)",
      "Mcp(*:*press*)",
      "Mcp(*:*drag*)",
      "Mcp(*:*gesture*)",
      "Mcp(*:*swipe*)"
    ]
  }
}
